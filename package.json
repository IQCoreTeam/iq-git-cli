{
  "name": "@iqlabs-official/iq-git-cli",
  "version": "0.1.0",
  "description": "Command-line client for on-chain Git on Solana. Talks to @iqlabs-official/git-sdk to commit, push, clone, and browse repos stored entirely on chain.",
  "keywords": [
    "solana",
    "git",
    "on-chain",
    "iqlabs",
    "iq-git",
    "cli"
  ],
  "type": "module",
  "bin": {
    "iqgit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "test": "bun tests/run.ts tests/unit tests/integration",
    "test:unit": "bun tests/run.ts tests/unit",
    "test:integration": "bun tests/run.ts tests/integration",
    "test:e2e": "bun tests/e2e/full-cycle.test.ts"
  },
  "dependencies": {
    "@iqlabs-official/git-sdk": "^0.1.4",
    "@iqlabs-official/solana-sdk": "^0.1.21",
    "@solana/web3.js": "^1.98.0",
    "@inquirer/prompts": "^5.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "ignore": "^5.3.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
